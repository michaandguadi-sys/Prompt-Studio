# ─────────────────────────────────────────────────────────────────────────────
# Mapanisy — BUILD-TIME environment (docker compose reads this file)
#
# Copy to `.env` next to docker-compose.yml on the VPS and fill in real values:
#     cp .env.example .env && nano .env
#
# ⚠ These three are INLINED INTO THE CLIENT BUNDLE at build time. Docker Compose
#   substitutes an EMPTY STRING for any variable missing from this file and only
#   prints a warning — the image then builds "successfully" with a blank Clerk
#   key, and every sign-in fails at runtime with no build error to point at it.
#   Fill all three BEFORE `docker compose up -d --build`.
#
# ⚠ Changing any value here requires a REBUILD (`--build`), not just a restart.
#
# Runtime secrets (CLERK_SECRET_KEY, ZAI_API_KEY, DATABASE_URL, Stripe, R2…)
# do NOT belong here — they go in `.env.production`. See .env.production.example.
# ─────────────────────────────────────────────────────────────────────────────

# Clerk publishable key — Dashboard → API Keys. Must be the PRODUCTION instance
# (pk_live_…) for a real domain; pk_test_… only works on localhost.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_

# The public origin users reach, including https:// and no trailing slash.
# Used for share links, OG tags, sitemap, and Stripe redirect URLs.
NEXT_PUBLIC_APP_URL=https://mapanisy.com

# Mapbox token — OPTIONAL. The app renders with MapLibre + free tile sources by
# default. Leave EMPTY unless you have a paid Mapbox plan.
NEXT_PUBLIC_MAPBOX_TOKEN=
