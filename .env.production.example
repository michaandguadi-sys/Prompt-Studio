# ─────────────────────────────────────────────────────────────────────────────
# Mapanisy — production environment template
# Copy this to .env.production on the VPS and fill in every value.
# Never commit .env.production — it is in .gitignore.
#
# BUILD-TIME vars (also passed as --build-arg to docker build) go in a
# separate .env file next to docker-compose.yml on the VPS:
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
#   NEXT_PUBLIC_APP_URL=https://mapanisy.com
#   NEXT_PUBLIC_MAPBOX_TOKEN=           ← optional, empty string is fine
# ─────────────────────────────────────────────────────────────────────────────

# ── Clerk (auth) ─────────────────────────────────────────────────────────────
# Create a PRODUCTION instance at https://dashboard.clerk.com
# → API Keys → show secret key. The publishable key also goes in .env (build arg).
CLERK_SECRET_KEY=sk_live_

# Needed to verify Clerk webhook payloads (sync user records on sign-up/delete).
# Dashboard → Webhooks → Add endpoint → https://mapanisy.com/api/webhooks/clerk
# Events: user.created, user.deleted, user.updated
CLERK_WEBHOOK_SECRET=whsec_

# ── AI director ──────────────────────────────────────────────────────────────
# ZAI_API_KEY is the BUILT-IN story engine (Z.ai GLM, free tier) — set this and
# every user gets a working AI Director with zero setup. See docs/ZAI_SETUP.md.
# ANTHROPIC_API_KEY (or OpenAI/Gemini) also works; users can BYO in Settings.
# At least one should be set; the built-in Z.ai key is the recommended default.
ZAI_API_KEY=
ANTHROPIC_API_KEY=sk-ant-

# ── Database (optional at launch) ────────────────────────────────────────────
# Without DATABASE_URL the app uses a JSON file store under .dev-data/ (volume
# mounted in docker-compose). Good for solo/MVP; add Postgres later for multi-user.
# Use a managed Postgres (Neon, Supabase, Hostinger DB, etc.) or run your own.
DATABASE_URL=

# ── Stripe (skip until billing is live) ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
# Paste the price IDs from your Stripe dashboard → Products.
# Creator = subscription (monthly + yearly). Pro = a ONE-TIME price ($250 lifetime).
STRIPE_PRICE_CREATOR=price_
STRIPE_PRICE_CREATOR_ANNUAL=price_
STRIPE_PRICE_PRO=price_

# ── Cloudflare R2 / S3 storage (optional — renders served locally without it) ─
# Without R2 the rendered MP4s live under .renders/ (docker volume) and stream
# from the app itself. Works fine for MVP; add R2 for CDN delivery later.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mapanisy-renders
R2_PUBLIC_URL=https://renders.mapanisy.com
