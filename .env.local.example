# ── App URL (used for Stripe redirect URLs) ───────────────────────────────────
# Dev: http://localhost:3030   Prod: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3030

# ── Clerk ────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Clerk sign-in/sign-up redirect paths (must match your Clerk dashboard settings)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Clerk Webhook Signing Secret (from Clerk Dashboard → Webhooks → your endpoint → Signing Secret)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ── Supabase / Database ───────────────────────────────────────────────────────
# Get from https://app.supabase.com → Your Project → Settings → Database → Connection string (URI)
# Use the "Transaction" pooler URL (port 6543) for serverless/edge, or Direct (5432) for migrations.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── Mapbox ────────────────────────────────────────────────────────────────────
# Already in your local .env.local — keep as-is
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_public_mapbox_token_here

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs — create these in Stripe Dashboard → Products first.
# Customer ladder: Creator $19 · Pro $39 · Studio $99 · Enterprise (contact).
# Internal tier ids are kept stable, so: TEAMS backs Pro, CUSTOM backs Studio,
# AGENCY backs Enterprise (renaming them would churn the DB + this mapping).
STRIPE_PRICE_CREATOR=price_xxxxxxxxxxxxxxxxxxxx   # Creator — $19/mo
STRIPE_PRICE_TEAMS=price_xxxxxxxxxxxxxxxxxxxx     # Pro — $39/mo
STRIPE_PRICE_CUSTOM=price_xxxxxxxxxxxxxxxxxxxx    # Studio — $99/mo
STRIPE_PRICE_AGENCY=price_xxxxxxxxxxxxxxxxxxxx    # Enterprise — contact

# ── Cloudflare R2 (for render output storage) ─────────────────────────────────
# Get from https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=prompt-studio-renders
R2_PUBLIC_URL=https://your-r2-subdomain.r2.dev

# ── AI director (idea → map animation) ────────────────────────────────────────
# The director is provider-agnostic. Pick ONE. If unset, it auto-detects from
# whichever key is present; with no key it uses the built-in heuristic planner.
# AI_PROVIDER=anthropic            # anthropic | openai | openai-compatible (optional; inferred from keys)
# AI_MODEL=claude-sonnet-4-5       # model id (provider-specific; sensible default per provider)
#
# Option A — Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
#
# Option B — OpenAI
# OPENAI_API_KEY=sk-...
#
# Option C — any OpenAI-compatible endpoint (Groq, Together, OpenRouter, local, …)
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=...
# AI_MODEL=llama-3.3-70b-versatile
#
# OPTIONAL — generative imagery for `image` layers (OpenAI-images-compatible)
# AI_IMAGE_URL=https://api.openai.com/v1/images/generations
# AI_IMAGE_KEY=sk-...
# AI_IMAGE_MODEL=gpt-image-1

# ── AI restyle (re-style a rendered clip via video-to-video) ──────────────────
# Operators can set a default; users can also bring their own in Settings.
# Option A — Replicate (hosts many video-restyle models)
# RESTYLE_PROVIDER=replicate
# REPLICATE_API_TOKEN=r8_...
# RESTYLE_MODEL=<model-version-hash>
#
# Option B — any custom endpoint (Higgsfield / Runway / your own)
# RESTYLE_PROVIDER=generic
# RESTYLE_URL=https://api.your-provider.com/restyle
# RESTYLE_KEY=...
# RESTYLE_MODEL=your-model
# (the restyle input video must be a public URL — uploads use the R2 config above)
